From f70d03b68249edc14829eb578ccf4f2f276593a5 Mon Sep 17 00:00:00 2001
From: Filippo Luca Ferretti <filippoluca.ferretti@outlook.com>
Date: Fri, 27 Mar 2026 17:38:01 +0100
Subject: [PATCH] Remove absl_low_level_hash merged into absl_hash in 20260107

---
 third_party/xla/third_party/absl/system.absl.hash.BUILD | 8 +-------
 1 file changed, 1 insertion(+), 7 deletions(-)

diff --git a/third_party/xla/third_party/absl/system.absl.hash.BUILD b/third_party/xla/third_party/absl/system.absl.hash.BUILD
index 3367340c..4b10eb64 100644
--- a/third_party/xla/third_party/absl/system.absl.hash.BUILD
+++ b/third_party/xla/third_party/absl/system.absl.hash.BUILD
@@ -7,7 +7,6 @@ cc_library(
     linkopts = ["-labsl_hash"],
     deps = [
         ":city",
-        ":low_level_hash",
         "//absl/base:endian",
         "//absl/container:fixed_array",
         "//absl/numeric:int128",
@@ -28,10 +27,5 @@ cc_library(
 
 cc_library(
     name = "low_level_hash",
-    linkopts = ["-labsl_low_level_hash"],
-    visibility = ["//visibility:private"],
-    deps = [
-        "//absl/base:endian",
-        "//absl/numeric:int128",
-    ],
+    # absl_low_level_hash was merged into absl_hash in 20260107
 )
