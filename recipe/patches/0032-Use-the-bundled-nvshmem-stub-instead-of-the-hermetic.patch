From ff7280a7f910c8ac548e567bcadbe959f501a6d0 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sun, 17 May 2026 22:22:44 -0400
Subject: [PATCH] Use the bundled nvshmem stub instead of the hermetic redist

The hermetic @nvidia_nvshmem redist (NVSHMEM 3.2.5) ships no cuda13
archive, so the build aborts fetching it on CUDA 13. conda-forge does not
package NVSHMEM, so always use the bundled dlopen stub (:nvshmem) instead
of the @nvidia_nvshmem alias.
---
 third_party/xla/xla/tsl/cuda/BUILD.bazel | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/third_party/xla/xla/tsl/cuda/BUILD.bazel b/third_party/xla/xla/tsl/cuda/BUILD.bazel
index 52a2a3f8..feae07cd 100644
--- a/third_party/xla/xla/tsl/cuda/BUILD.bazel
+++ b/third_party/xla/xla/tsl/cuda/BUILD.bazel
@@ -419,7 +419,7 @@ cc_library(
 
 alias(
     name = "nvshmem_stub",
-    actual = if_cuda_libs("@nvidia_nvshmem//:nvshmem", ":nvshmem"),
+    actual = ":nvshmem",
     visibility = ["//visibility:public"],
 )
 
-- 
