From a729386ccc5480490d6623ccd053755ba7384f09 Mon Sep 17 00:00:00 2001
From: Isuru Fernando <ifernando@quansight.com>
Date: Wed, 6 Aug 2025 15:36:13 +0000
Subject: [PATCH] add absl_tracing_internal

---
 tensorflow/core/kernels/batching_util/BUILD             | 1 +
 third_party/xla/third_party/absl/system.absl.base.BUILD | 7 +++++++
 2 files changed, 8 insertions(+)

diff --git a/tensorflow/core/kernels/batching_util/BUILD b/tensorflow/core/kernels/batching_util/BUILD
index 74ee89ea..1817b432 100644
--- a/tensorflow/core/kernels/batching_util/BUILD
+++ b/tensorflow/core/kernels/batching_util/BUILD
@@ -478,6 +478,7 @@ cc_library(
         "@com_google_absl//absl/synchronization",
         "@com_google_absl//absl/time",
         "@com_google_absl//absl/types:optional",
+        "@com_google_absl//absl/base:tracing_internal",
         "@xla//xla/tsl/platform:criticality",
     ],
 )
diff --git a/third_party/xla/third_party/absl/system.absl.base.BUILD b/third_party/xla/third_party/absl/system.absl.base.BUILD
index b31592d3..65347936 100644
--- a/third_party/xla/third_party/absl/system.absl.base.BUILD
+++ b/third_party/xla/third_party/absl/system.absl.base.BUILD
@@ -25,6 +25,13 @@ cc_library(
     ],
 )
 
+cc_library(
+    name = "tracing_internal",
+    linkopts = [
+        "-labsl_tracing_internal",
+    ],
+)
+
 cc_library(
     name = "nullability",
     deps = [
