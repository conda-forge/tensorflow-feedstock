diff --git a/third_party/systemlibs/grpc.bazel.python_rules.bzl b/third_party/systemlibs/grpc.bazel.python_rules.bzl
new file mode 100644
index 00000000..9ff9e421
--- /dev/null
+++ b/third_party/systemlibs/grpc.bazel.python_rules.bzl
@@ -0,0 +1,18 @@
+"""Shim providing py_grpc_library for a systemized gRPC.
+
+The system gRPC package does not ship the gRPC Python codegen plugin, so
+py_grpc_library produces an empty py_library (no *_pb2_grpc.py stubs). This is
+sufficient for the C/C++ and Python TensorFlow targets built by the
+conda-forge feedstock.
+"""
+
+load("@rules_python//python:py_library.bzl", "py_library")
+
+def py_grpc_library(name, srcs = [], deps = [], **kwargs):
+    _ = (srcs, deps)  # @unused
+    py_library(
+        name = name,
+        srcs = [],
+        deps = [],
+        **{k: v for k, v in kwargs.items() if k in ("testonly", "compatible_with", "visibility")}
+    )
diff --git a/third_party/systemlibs/protobuf.bazel.cc_proto_library.bzl b/third_party/systemlibs/protobuf.bazel.cc_proto_library.bzl
new file mode 100644
index 00000000..c428ba90
--- /dev/null
+++ b/third_party/systemlibs/protobuf.bazel.cc_proto_library.bzl
@@ -0,0 +1,5 @@
+"""Shim so @com_google_protobuf//bazel:cc_proto_library.bzl resolves for system protobuf."""
+
+load("@com_google_protobuf//:protobuf.bzl", _cc_proto_library = "cc_proto_library")
+
+cc_proto_library = _cc_proto_library
diff --git a/third_party/systemlibs/protobuf.bazel.java_lite_proto_library.bzl b/third_party/systemlibs/protobuf.bazel.java_lite_proto_library.bzl
new file mode 100644
index 00000000..921b83a5
--- /dev/null
