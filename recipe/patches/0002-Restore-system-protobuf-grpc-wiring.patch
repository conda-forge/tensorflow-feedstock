@@ -0,0 +1,13 @@
+"""Shim so @com_google_protobuf//bazel:java_lite_proto_library.bzl resolves for system protobuf.
+
+The conda-forge feedstock does not build the TensorFlow Java API; this stub
+just lets BUILD files that load java_lite_proto_library resolve. If invoked it
+produces an empty filegroup.
+"""
+
+def java_lite_proto_library(name, **kwargs):
+    native.filegroup(
+        name = name,
+        srcs = [],
+        **{k: v for k, v in kwargs.items() if k in ("visibility", "compatible_with", "testonly")}
+    )
